{
  "name": "Shared Todo",
  "short_name": "Todo",
  "description": "Samen waar gewenst. Privé waar nodig.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#efe9dd",
  "theme_color": "#efe9dd",
  "lang": "nl-NL",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
